# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
ENV/
.venv/

# Application Cache & Sensitive Configs (CRITICAL: API keys & rules cache)
cache/*
!cache/.gitkeep

# Application Logs & Diagnostics
logs/*
!logs/.gitkeep
*.log

# Workspace & User Data (Scripts and processed manga files)
translations/*
!translations/.gitkeep
processed/*
!processed/.gitkeep

# PyInstaller / Build Artifacts
build/
dist/
*.spec
_internal/
MangaTranslate_Data/
*.exe

# OS generated metadata
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editor Configuration
.vscode/
.idea/
*.sublime-workspace
*.sublime-project